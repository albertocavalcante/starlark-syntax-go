# ==============================================================================
# .copybara/starlark.bara.sky
#
# Syncs the Starlark parser from google/starlark-go to starlark/
#
# COPYBARA REFERENCE DOCUMENTATION:
#   - Full Reference: https://github.com/google/copybara/blob/master/docs/reference.md
#   - Examples: https://github.com/google/copybara/blob/master/docs/examples.md
#
# UPSTREAM SOURCE:
#   - Repository: https://github.com/google/starlark-go
#   - Package: syntax/ (Starlark parser and AST)
#   - License: BSD-3-Clause
# ==============================================================================

# See bzl.bara.sky for detailed documentation on authoring.pass_thru()
defaultAuthor = authoring.pass_thru("Eukia[bot] <eukia[bot]@users.noreply.github.com>")

core.workflow(
    name = "sync-starlark-parser",

    # See bzl.bara.sky for detailed documentation on git.origin()
    origin = git.origin(
        url = "https://github.com/google/starlark-go.git",
        ref = "master",
    ),

    # See bzl.bara.sky for detailed documentation on git.github_destination()
    destination = git.github_destination(
        url = "https://github.com/albertocavalcante/starlark-syntax-go.git",
        push = "main",
    ),

    # Files to sync from starlark-go/syntax/
    origin_files = glob(
        include = [
            "syntax/syntax.go",    # AST node types
            "syntax/parse.go",     # Recursive-descent parser
            "syntax/scan.go",      # Lexical scanner
            "syntax/quote.go",     # String quoting utilities
            "syntax/walk.go",      # AST traversal
            "LICENSE",             # BSD-3-Clause license
        ],
        exclude = [
            "**/*_test.go",        # Exclude all test files
        ],
    ),

    # Manage starlark/ directory, but exclude doc.go (maintained directly)
    destination_files = glob(
        include = ["starlark/**"],
        exclude = ["starlark/doc.go"],
    ),

    # Preserve commit history
    mode = "ITERATIVE",

    authoring = defaultAuthor,

    transformations = [
        # STEP 1: Move syntax/ to starlark/
        # See bzl.bara.sky for detailed documentation on core.move()
        core.move("syntax", "starlark"),
        core.move("LICENSE", "starlark/LICENSE"),

        # STEP 2: Rename syntax.go to ast.go for clarity
        # See bzl.bara.sky for detailed documentation on core.rename()
        core.rename("syntax.go", "ast.go", paths = glob(["starlark/*.go"])),

        # STEP 3: Rewrite package declaration
        # See bzl.bara.sky for detailed documentation on core.replace()
        # GOTCHA: regex_groups={} is REQUIRED to enable regex mode!
        core.replace(
            before = "^package syntax$",
            after = "package starlark",
            regex_groups = {},       # Enable regex mode
            multiline = True,        # ^ and $ match line boundaries
            paths = glob(["starlark/*.go"]),
        ),

        # STEP 4: Rewrite imports (include quotes for precision)
        core.replace(
            before = '"go.starlark.net/syntax"',
            after = '"github.com/albertocavalcante/starlark-syntax-go/starlark"',
            paths = glob(["**/*.go"]),
        ),

        # STEP 5: Metadata
        metadata.expose_label("Co-authored-by"),
        metadata.expose_label("Signed-off-by"),
        metadata.add_header("Synced-From: google/starlark-go/syntax"),
    ],
)
