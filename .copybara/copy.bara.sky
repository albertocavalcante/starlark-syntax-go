# ==============================================================================
# .copybara/copy.bara.sky
#
# Copybara configuration for syncing Starlark parsers from upstream sources.
#
# WORKFLOWS:
#   - sync-bzl-parser: bazelbuild/buildtools → bzl/
#   - sync-starlark-parser: google/starlark-go → starlark/
#
# COPYBARA REFERENCE:
#   - https://github.com/google/copybara/blob/master/docs/reference.md
# ==============================================================================

_default_author = authoring.pass_thru("Eukia[bot] <eukia[bot]@users.noreply.github.com>")

def safe_replace(before, after, paths = glob(["**/*.go"])):
    """Noop-tolerant replace for ITERATIVE mode.

    In ITERATIVE mode, Copybara processes each upstream commit individually.
    A commit may only touch files that don't contain the target string (e.g.,
    files within a package don't import themselves), making the replace a no-op.
    """
    return core.transform([
        core.replace(before = before, after = after, paths = paths),
    ], noop_behavior = "IGNORE_NOOP")

# ==============================================================================
# WORKFLOW: sync-bzl-parser
# Source: bazelbuild/buildtools (Apache 2.0)
# ==============================================================================
core.workflow(
    name = "sync-bzl-parser",

    origin = git.origin(
        url = "https://github.com/bazelbuild/buildtools.git",
        ref = "main",
    ),

    destination = git.github_destination(
        url = "https://github.com/albertocavalcante/starlark-syntax-go.git",
        push = "main",
    ),

    origin_files = glob(
        include = [
            # Main sources
            "build/lex.go",
            "build/parse.y.go",
            "build/syntax.go",
            "build/quote.go",
            "build/walk.go",
            "build/utils.go",
            "labels/labels.go",
            # Tests
            "build/*_test.go",
            # Test utilities (synced to internal/ to hide from external users)
            "testutils/*.go",
            # License
            "LICENSE",
        ],
    ),

    destination_files = glob(
        include = ["bzl/**", "internal/testutils/**"],
        exclude = ["bzl/doc.go"],
    ),

    mode = "ITERATIVE",
    authoring = _default_author,

    transformations = [
        # Move main sources
        core.move("build", "bzl"),
        core.move("labels", "bzl/labels"),
        core.move("LICENSE", "bzl/LICENSE"),

        # Move testutils to internal/ (Go convention: hidden from external importers)
        core.move("testutils", "internal/testutils"),

        # Rename files
        core.rename("parse.y.go", "parse.go", paths = glob(["bzl/*.go"])),
        core.rename("syntax.go", "ast.go", paths = glob(["bzl/*.go"])),
        core.rename("utils.go", "position.go", paths = glob(["bzl/*.go"])),

        # Rewrite package and import paths (safe_replace tolerates no-ops)
        safe_replace("package build", "package bzl", glob(["bzl/*.go"])),
        safe_replace('"github.com/bazelbuild/buildtools/build"', '"github.com/albertocavalcante/starlark-syntax-go/bzl"'),
        safe_replace('"github.com/bazelbuild/buildtools/labels"', '"github.com/albertocavalcante/starlark-syntax-go/bzl/labels"'),
        safe_replace('"github.com/bazelbuild/buildtools/testutils"', '"github.com/albertocavalcante/starlark-syntax-go/internal/testutils"'),

        metadata.expose_label("Co-authored-by"),
        metadata.expose_label("Signed-off-by"),
        metadata.add_header("Synced-From: bazelbuild/buildtools/build"),
    ],
)

# ==============================================================================
# WORKFLOW: sync-starlark-parser
# Source: google/starlark-go (BSD-3-Clause)
# ==============================================================================
core.workflow(
    name = "sync-starlark-parser",

    origin = git.origin(
        url = "https://github.com/google/starlark-go.git",
        ref = "master",
    ),

    destination = git.github_destination(
        url = "https://github.com/albertocavalcante/starlark-syntax-go.git",
        push = "main",
    ),

    origin_files = glob(
        include = [
            # Main sources
            "syntax/syntax.go",
            "syntax/options.go",
            "syntax/parse.go",
            "syntax/scan.go",
            "syntax/quote.go",
            "syntax/walk.go",
            # Tests (stdlib only, no external deps)
            "syntax/*_test.go",
            # Test data
            "syntax/testdata/**",
            # License
            "LICENSE",
        ],
    ),

    destination_files = glob(
        include = ["starlark/**"],
        exclude = ["starlark/doc.go"],
    ),

    mode = "ITERATIVE",
    authoring = _default_author,

    transformations = [
        core.move("syntax", "starlark"),
        core.move("LICENSE", "starlark/LICENSE"),

        core.rename("syntax.go", "ast.go", paths = glob(["starlark/*.go"])),

        # Rewrite package and import paths (safe_replace tolerates no-ops)
        safe_replace("package syntax", "package starlark", glob(["starlark/*.go"])),
        safe_replace('"go.starlark.net/syntax"', '"github.com/albertocavalcante/starlark-syntax-go/starlark"'),

        metadata.expose_label("Co-authored-by"),
        metadata.expose_label("Signed-off-by"),
        metadata.add_header("Synced-From: google/starlark-go/syntax"),
    ],
)
